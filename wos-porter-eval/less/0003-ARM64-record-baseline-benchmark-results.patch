index 0000000..50af757
--- /dev/null
+++ b/benchmarks/run_bench.sh
@@ -0,0 +1,85 @@
+#!/bin/sh
+# Simple, reproducible benchmark for less (no upstream benchmark exists).
+#
+# usage: run_bench.sh LABEL LESS_EXE [LESS_T_EXE] [DATADIR] [ITERATIONS]
+#
+#   LESS_EXE    production less binary (used for the non-tty pipe test)
+#   LESS_T_EXE  less built with -DLESSTEST (make check builds less_t);
+#               it accepts --tty FILE, so keystrokes can be scripted
+#               without a pty, exactly as lesstest drives it.  If empty,
+#               only the pipe test runs.
+#   DATADIR     where the generated input file is kept (default: ./bench-data)
+#   ITERATIONS  timed runs per case (default 7); one untimed warm-up run
+#
+# Input: 1,000,000 deterministic lines (~62 MB) generated with awk, plus a
+# unique last line "ZZEND marker 424242" so forward searches scan the
+# whole file.
+#
+# Cases:
+#   pipe_cat     less FILE > OUTFILE              (non-tty: copies via ch.c;
+#                output goes to a regular file, not /dev/null, because the
+#                MSVC CRT reports NUL as a tty and less would go interactive;
+#                the warm-up output is cmp'd against the input)
+#   search_fwd   /ZZEND m[a-z]+ [0-9]{6}$ then q  (PCRE2, scans to EOF)
+#   search_back  G then ?^line 1:  then q          (EOF, backward scan)
+#   linenum_end  -N, G then q                      (line numbers to EOF)
+#
+# Output: one line per case: label case min/median/mean ms over N runs.
+# Run ARM64 binaries from an ARM64 shell and x64 binaries from an x64
+# shell so each process tree uses a single msys-2.0.dll.
+# Set BENCH_WINPATH=1 for a native (MSVC) less so the input path is passed
+# as C:/... (the aarch64 MSYS runtime does not convert argv for native exes).
+
+LABEL=$1; LESS_BIN=$2; LESS_T_BIN=${3:-}; DATADIR=${4:-./bench-data}; N=${5:-7}
+[ -n "$LABEL" ] && [ -n "$LESS_BIN" ] || { echo "usage: $0 LABEL LESS_EXE [LESS_T_EXE] [DATADIR] [N]" >&2; exit 2; }
+
+mkdir -p "$DATADIR" || exit 1
+BIG=$DATADIR/bench_input.txt
+if [ ! -f "$BIG" ]; then
+	awk 'BEGIN { for (i = 1; i <= 1000000; i++)
+		printf "line %d: the quick brown fox jumps over the lazy dog %d\n", i, (i * 7919) % 100003
+		print "ZZEND marker 424242" }' > "$BIG" || exit 1
+fi
+
+export TERM=xterm LINES=40 COLUMNS=120
+unset LESS LESSOPEN LESSCLOSE 2>/dev/null
+K=$DATADIR/keys.$$
+OUTF=$DATADIR/pipe_out.$$
+cleanup() { rm -f "$K.fwd" "$K.back" "$K.end" "$OUTF"; }
+trap cleanup EXIT
+printf '/ZZEND m[a-z]+ [0-9]{6}$\rq' > "$K.fwd"
+printf 'G?^line 1: \rq' > "$K.back"
+printf 'Gq' > "$K.end"
+
+now_ns() { date +%s%N; }
+
+BIGARG=$BIG
+if [ "${BENCH_WINPATH:-0}" = 1 ]; then
+	BIGARG=$(cygpath -m "$BIG" 2>/dev/null || echo "$BIG" | sed 's|^/\(.\)/|\1:/|')
+fi
+
+# time_case NAME OUT CMD...: one warm-up, then N timed runs, stdout to OUT
+time_case() {
+	name=$1; out=$2; shift 2
+	"$@" > "$out" 2>&1
+	rc=$?
+	if [ "$out" != /dev/null ]; then cmp -s "$out" "$BIG" || rc="$rc,cmp-differs"; fi
+	times=""
+	i=0
+	while [ $i -lt "$N" ]; do
+		t0=$(now_ns); "$@" > "$out" 2>&1; t1=$(now_ns)
+		times="$times $(( (t1 - t0) / 1000000 ))"
+		i=$((i + 1))
+	done
+	echo "$times" | tr ' ' '\n' | grep -v '^$' | sort -n | awk -v l="$LABEL" -v c="$name" -v rc="$rc" '
+		{ a[NR] = $1; s += $1 }
+		END { med = (NR % 2) ? a[(NR + 1) / 2] : (a[NR / 2] + a[NR / 2 + 1]) / 2
+		      printf "%-12s %-12s min=%6d ms  median=%6d ms  mean=%8.1f ms  n=%d  rc=%s\n", l, c, a[1], med, s / NR, NR, rc }'
+}
+
+time_case pipe_cat "$OUTF" "$LESS_BIN" "$BIGARG"
+if [ -n "$LESS_T_BIN" ]; then
+	time_case search_fwd  /dev/null "$LESS_T_BIN" --tty "$K.fwd"  -n "$BIG"
+	time_case search_back /dev/null "$LESS_T_BIN" --tty "$K.back" -n "$BIG"
+	time_case linenum_end /dev/null "$LESS_T_BIN" --tty "$K.end"  -N "$BIG"
+fi
