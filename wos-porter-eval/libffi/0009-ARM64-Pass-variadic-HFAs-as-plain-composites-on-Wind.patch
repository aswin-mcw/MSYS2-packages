   ffi_status status = ffi_prep_cif_machdep (cif);
   cif->flags |= AARCH64_FLAG_VARARG;
+  /* Windows ARM64 variadic calls also pass HFAs/HVAs larger than 16 bytes
+     by reference; reserve the pointer slot that ffi_prep_cif_machdep only
+     reserves for other composites.  */
