 src/aarch64/ffi.c              | 119 +++++++++++++++++--------------
 testsuite/libffi.call/va_hfa.c | 126 +++++++++++++++++++++++++++++++++
 2 files changed, 193 insertions(+), 52 deletions(-)
 create mode 100644 testsuite/libffi.call/va_hfa.c

