diff --git a/testsuite/libffi.call/va_hfa.c b/testsuite/libffi.call/va_hfa.c
new file mode 100644
index 0000000..36f3163
--- /dev/null
+++ b/testsuite/libffi.call/va_hfa.c
@@ -0,0 +1,126 @@
+/* Area:		ffi_call, closure_call
+   Purpose:		Test passing HFAs in variable argument lists, including
+			HFAs split between the last argument registers and the
+			stack.  On Windows ARM64 these are plain composites.
+   Limitations:	none.
+   PR:			none.
+   Originator:	none.  */
+
+/* { dg-do run } */
+
+#include "ffitest.h"
+#include <stdarg.h>
+typedef struct { float a, b; } F2;
+typedef struct { float a, b, c; } F3;
+typedef struct { float a, b, c, d; } F4;
+typedef struct { double a, b; } D2;
+typedef struct { double a, b, c; } D3;
+typedef struct { double a, b, c, d; } D4;
+
+static int fails;
+#define CHK(c) do { if (!(c)) { printf("FAIL %s:%d %s\n", __FILE__, __LINE__, #c); fails++; } } while (0)
+
+/* nint leading ints, then: F2, F3, F4, D2, D3, D4, double */
+static double callee(int nint, ...)
+{
+  va_list ap; double s = 0; int i;
+  va_start(ap, nint);
+  for (i = 0; i < nint; i++) s += va_arg(ap, int);
+  { F2 x = va_arg(ap, F2); s += x.a * 1 + x.b * 2; }
+  { F3 x = va_arg(ap, F3); s += x.a * 3 + x.b * 4 + x.c * 5; }
+  { F4 x = va_arg(ap, F4); s += x.a * 6 + x.b * 7 + x.c * 8 + x.d * 9; }
+  { D2 x = va_arg(ap, D2); s += x.a * 10 + x.b * 11; }
+  { D3 x = va_arg(ap, D3); s += x.a * 12 + x.b * 13 + x.c * 14; }
+  { D4 x = va_arg(ap, D4); s += x.a * 15 + x.b * 16 + x.c * 17 + x.d * 18; }
+  s += va_arg(ap, double) * 19;
+  va_end(ap);
+  return s;
+}
+
+static ffi_type *mk(ffi_type *el, int n, ffi_type *t, ffi_type **e)
+{
+  int i;
+  for (i = 0; i < n; i++) e[i] = el;
+  e[n] = NULL;
+  t->size = 0; t->alignment = 0; t->type = FFI_TYPE_STRUCT; t->elements = e;
+  return t;
+}
+
+static F2 f2 = {1, 2}; static F3 f3 = {3, 4, 5}; static F4 f4 = {6, 7, 8, 9};
+static D2 d2 = {10, 11}; static D3 d3 = {12, 13, 14}; static D4 d4 = {15, 16, 17, 18};
+static double dd = 19;
+
+
+/* closure: same signature, implemented via libffi */
+static void cls_fn(ffi_cif *cif, void *ret, void **args, void *ud)
+{
+  int nint = *(int *)args[0], i; double s = 0; F2 *x2; F3 *x3; F4 *x4; D2 *y2; D3 *y3; D4 *y4;
+  (void)ud; (void)cif;
+  for (i = 0; i < nint; i++) s += *(int *)args[1 + i];
+  x2 = args[1 + nint]; x3 = args[2 + nint]; x4 = args[3 + nint];
+  y2 = args[4 + nint]; y3 = args[5 + nint]; y4 = args[6 + nint];
+  s += x2->a * 1 + x2->b * 2;
+  s += x3->a * 3 + x3->b * 4 + x3->c * 5;
+  s += x4->a * 6 + x4->b * 7 + x4->c * 8 + x4->d * 9;
+  s += y2->a * 10 + y2->b * 11;
+  s += y3->a * 12 + y3->b * 13 + y3->c * 14;
+  s += y4->a * 15 + y4->b * 16 + y4->c * 17 + y4->d * 18;
+  s += *(double *)args[7 + nint] * 19;
+  *(double *)ret = s;
+}
+
+int main(void)
+{
+  ffi_type tf2, tf3, tf4, td2, td3, td4;
+  ffi_type *ef2[3], *ef3[4], *ef4[5], *ed2[3], *ed3[4], *ed4[5];
+  int nint;
+  mk(&ffi_type_float, 2, &tf2, ef2); mk(&ffi_type_float, 3, &tf3, ef3);
+  mk(&ffi_type_float, 4, &tf4, ef4); mk(&ffi_type_double, 2, &td2, ed2);
+  mk(&ffi_type_double, 3, &td3, ed3); mk(&ffi_type_double, 4, &td4, ed4);
+
+  for (nint = 0; nint <= 7; nint++)
+    {
+      ffi_cif cif; ffi_type *at[16]; void *av[16]; int iv[8] = {1,2,3,4,5,6,7,8};
+      int k = 0, i; double r = 0, want;
+      at[k] = &ffi_type_sint; av[k++] = &nint;
+      for (i = 0; i < nint; i++) { at[k] = &ffi_type_sint; av[k++] = &iv[i]; }
+      at[k] = &tf2; av[k++] = &f2; at[k] = &tf3; av[k++] = &f3; at[k] = &tf4; av[k++] = &f4;
+      at[k] = &td2; av[k++] = &d2; at[k] = &td3; av[k++] = &d3; at[k] = &td4; av[k++] = &d4;
+      at[k] = &ffi_type_double; av[k++] = &dd;
+      switch (nint) {
+        case 0: want = callee(0, f2, f3, f4, d2, d3, d4, dd); break;
+        case 1: want = callee(1, 1, f2, f3, f4, d2, d3, d4, dd); break;
+        case 2: want = callee(2, 1,2, f2, f3, f4, d2, d3, d4, dd); break;
+        case 3: want = callee(3, 1,2,3, f2, f3, f4, d2, d3, d4, dd); break;
+        case 4: want = callee(4, 1,2,3,4, f2, f3, f4, d2, d3, d4, dd); break;
+        case 5: want = callee(5, 1,2,3,4,5, f2, f3, f4, d2, d3, d4, dd); break;
+        case 6: want = callee(6, 1,2,3,4,5,6, f2, f3, f4, d2, d3, d4, dd); break;
+        default: want = callee(7, 1,2,3,4,5,6,7, f2, f3, f4, d2, d3, d4, dd); break;
+      }
+      CHK(ffi_prep_cif_var(&cif, FFI_DEFAULT_ABI, 1, k, &ffi_type_double, at) == FFI_OK);
+      ffi_call(&cif, FFI_FN(callee), &r, av);
+      printf("call nint=%d got %g want %g\n", nint, r, want);
+      CHK(r == want);
+
+      {
+        void *code; ffi_closure *cl = ffi_closure_alloc(sizeof(ffi_closure), &code);
+        double (*fp)(int, ...) = (double (*)(int, ...))code; double got;
+        CHK(ffi_prep_closure_loc(cl, &cif, cls_fn, NULL, code) == FFI_OK);
+        switch (nint) {
+          case 0: got = fp(0, f2, f3, f4, d2, d3, d4, dd); break;
+          case 1: got = fp(1, 1, f2, f3, f4, d2, d3, d4, dd); break;
+          case 2: got = fp(2, 1,2, f2, f3, f4, d2, d3, d4, dd); break;
+          case 3: got = fp(3, 1,2,3, f2, f3, f4, d2, d3, d4, dd); break;
+          case 4: got = fp(4, 1,2,3,4, f2, f3, f4, d2, d3, d4, dd); break;
+          case 5: got = fp(5, 1,2,3,4,5, f2, f3, f4, d2, d3, d4, dd); break;
+          case 6: got = fp(6, 1,2,3,4,5,6, f2, f3, f4, d2, d3, d4, dd); break;
+          default: got = fp(7, 1,2,3,4,5,6,7, f2, f3, f4, d2, d3, d4, dd); break;
+        }
+        printf("closure nint=%d got %g want %g\n", nint, got, want);
+        CHK(got == want);
+        ffi_closure_free(cl);
+      }
+    }
+  CHECK(fails == 0);
+  exit(0);
+}
-- 
