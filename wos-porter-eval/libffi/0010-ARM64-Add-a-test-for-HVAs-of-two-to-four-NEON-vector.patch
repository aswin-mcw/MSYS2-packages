diff --git a/testsuite/libffi.call/hva_neon.c b/testsuite/libffi.call/hva_neon.c
new file mode 100644
index 0000000..b9f2b29
--- /dev/null
+++ b/testsuite/libffi.call/hva_neon.c
@@ -0,0 +1,66 @@
+/* Area:		ffi_call, closure_call
+   Purpose:		Test passing homogeneous short-vector aggregates (HVAs)
+			of two to four 128-bit NEON vectors by value.
+   Limitations:	AArch64 with <arm_neon.h>.
+   PR:			none.
+   Originator:	none.  */
+
+/* { dg-do run { target aarch64*-*-* } } */
+
+#include "ffitest.h"
+#include <arm_neon.h>
+typedef struct { float32x4_t a, b; } V2;
+typedef struct { float32x4_t a, b, c; } V3;
+typedef struct { float32x4_t a, b, c, d; } V4;
+
+static int fails;
+#define CHK(c) do { if (!(c)) { printf("FAIL line %d: %s\n", __LINE__, #c); fails++; } } while (0)
+
+static float sumv(float32x4_t v, float w) { return w * vaddvq_f32(v); }
+static float f2(V2 x) { return sumv(x.a, 1) + sumv(x.b, 2); }
+static float f3(V3 x) { return sumv(x.a, 1) + sumv(x.b, 2) + sumv(x.c, 3); }
+static float f4(V4 x) { return sumv(x.a, 1) + sumv(x.b, 2) + sumv(x.c, 3) + sumv(x.d, 4); }
+
+static void cls(ffi_cif *cif, void *ret, void **args, void *ud)
+{
+  int n = (int)(size_t)ud, i; float s = 0; float32x4_t *v = args[0];
+  (void)cif;
+  for (i = 0; i < n; i++) s += sumv(v[i], (float)(i + 1));
+  *(float *)ret = s;
+}
+
+int main(void)
+{
+  static float32x4_t vs[4];
+  ffi_type vec, st[3]; ffi_type *velems[5], *selems[3][5];
+  int i, n;
+  for (i = 0; i < 4; i++) { float t[4] = {i*4+1.f, i*4+2.f, i*4+3.f, i*4+4.f}; vs[i] = vld1q_f32(t); }
+  for (i = 0; i < 4; i++) velems[i] = &ffi_type_float;
+  velems[4] = NULL;
+  vec.size = 0; vec.alignment = 0; vec.type = FFI_TYPE_VECTOR; vec.elements = velems;
+  for (n = 2; n <= 4; n++)
+    {
+      ffi_cif cif; ffi_type *at[1]; void *av[1]; float r = 0, want, got;
+      void *code; ffi_closure *cl;
+      ffi_type *t = &st[n - 2];
+      for (i = 0; i < n; i++) selems[n - 2][i] = &vec;
+      selems[n - 2][n] = NULL;
+      t->size = 0; t->alignment = 0; t->type = FFI_TYPE_STRUCT; t->elements = selems[n - 2];
+      at[0] = t; av[0] = vs;
+      CHK(ffi_prep_cif(&cif, FFI_DEFAULT_ABI, 1, &ffi_type_float, at) == FFI_OK);
+      want = n == 2 ? f2(*(V2 *)vs) : n == 3 ? f3(*(V3 *)vs) : f4(*(V4 *)vs);
+      ffi_call(&cif, n == 2 ? FFI_FN(f2) : n == 3 ? FFI_FN(f3) : FFI_FN(f4), &r, av);
+      printf("call HVA%d got %g want %g\n", n, r, want);
+      CHK(r == want);
+      cl = ffi_closure_alloc(sizeof(ffi_closure), &code);
+      CHK(ffi_prep_closure_loc(cl, &cif, cls, (void *)(size_t)n, code) == FFI_OK);
+      got = n == 2 ? ((float (*)(V2))code)(*(V2 *)vs)
+          : n == 3 ? ((float (*)(V3))code)(*(V3 *)vs)
+          : ((float (*)(V4))code)(*(V4 *)vs);
+      printf("closure HVA%d got %g want %g\n", n, got, want);
+      CHK(got == want);
+      ffi_closure_free(cl);
+    }
+  CHECK(fails == 0);
+  exit(0);
+}
