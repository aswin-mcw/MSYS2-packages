From 047daafe6cfbc867609acddfecaba139e381458d Mon Sep 17 00:00:00 2001
From: aswin-mcw <aswin.kalies@multicorewareinc.com>
Date: Sun, 22 Nov 2026 00:55:36 +0530
Subject: [PATCH 1/3] ARM64: honour CC_FOR_BUILD when configure is not cross
 compiling

If only --host=aarch64-pc-cygwin is given (no --build), autoconf starts
with cross_compiling=maybe. On a Windows ARM64 machine that can run the
aarch64 test program, that turns into "no", and configure then replaced
a user-supplied CC_FOR_BUILD with $CC. The generators (mkinit, mksyntax,
mknodes, mksignames) were built as aarch64 binaries that the x86_64 msys
make cannot run.

Use ${CC_FOR_BUILD-$CC} so an explicit CC_FOR_BUILD wins and native
builds still default to $CC. configure regenerated with autoconf 2.72.

Signed-off-by: aswin-mcw <aswin.kalies@multicorewareinc.com>
---
 configure    | 2 +-
 configure.ac | 2 +-
 2 files changed, 2 insertions(+), 2 deletions(-)

diff --git a/configure b/configure
index e4948a6..e261dc0 100644
--- a/configure
+++ b/configure
@@ -5004,7 +5004,7 @@ printf %s "checking for build system compiler... " >&6; }
 if test "$cross_compiling" = yes; then
 	CC_FOR_BUILD=${CC_FOR_BUILD-cc}
 else
-	CC_FOR_BUILD=${CC}
+	CC_FOR_BUILD=${CC_FOR_BUILD-$CC}
 fi
 { printf "%s\n" "$as_me:${as_lineno-$LINENO}: result: ${CC_FOR_BUILD}" >&5
 printf "%s\n" "${CC_FOR_BUILD}" >&6; }
diff --git a/configure.ac b/configure.ac
index a247d95..4ae015c 100644
--- a/configure.ac
+++ b/configure.ac
@@ -14,7 +14,7 @@ AC_MSG_CHECKING([for build system compiler])
 if test "$cross_compiling" = yes; then
 	CC_FOR_BUILD=${CC_FOR_BUILD-cc}
 else
-	CC_FOR_BUILD=${CC}
+	CC_FOR_BUILD=${CC_FOR_BUILD-$CC}
 fi
 AC_MSG_RESULT(${CC_FOR_BUILD})
 AC_SUBST(CC_FOR_BUILD)
-- 
