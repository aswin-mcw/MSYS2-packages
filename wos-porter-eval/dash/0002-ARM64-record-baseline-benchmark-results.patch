index 0000000..30716c5
--- /dev/null
+++ b/benchmarks/scripts/fork_subshell.sh
@@ -0,0 +1,4 @@
+# fork-heavy loop: 500 $(:) command-substitution subshells
+i=0
+while [ $i -lt 500 ]; do x=$(:); i=$((i + 1)); done
+echo "$i"
diff --git a/benchmarks/scripts/func_call.sh b/benchmarks/scripts/func_call.sh
new file mode 100644
index 0000000..2892926
--- /dev/null
+++ b/benchmarks/scripts/func_call.sh
@@ -0,0 +1,5 @@
+# shell function call loop
+add() { r=$(( $1 + $2 )); }
+i=0; acc=0
+while [ $i -lt 200000 ]; do add $acc $i; acc=$((r % 1000003)); i=$((i + 1)); done
+echo "$acc"
diff --git a/benchmarks/scripts/run_bench.ps1 b/benchmarks/scripts/run_bench.ps1
new file mode 100644
index 0000000..d9f21f1
--- /dev/null
+++ b/benchmarks/scripts/run_bench.ps1
@@ -0,0 +1,31 @@
+# Usage: powershell -NoProfile -ExecutionPolicy Bypass -File run_bench.ps1 [-Runs 5] [-Out results.csv]
+# Runs each benchmark script with the ARM64 and x64 dash (each as the root Cygwin process, launched from PowerShell).
+param([int]$Runs = 5, [string]$Out = "$PSScriptRoot\bench_raw.csv")
+$repo = Split-Path (Split-Path $PSScriptRoot -Parent) -Parent
+$arches = [ordered]@{
+  arm64 = @{ dash = "$repo\build-arm64\src\dash.exe"; bin = 'C:\gfw-native\native\usr\bin' }
+  x64   = @{ dash = "$repo\build-x64\src\dash.exe";   bin = 'C:\msys64\usr\bin' }
+}
+$benches = 'arith_loop','string_build','case_match','func_call','fork_subshell'
+$rows = @()
+foreach ($b in $benches) {
+  $script = (Join-Path $PSScriptRoot "$b.sh").Replace('\','/')
+  foreach ($a in $arches.Keys) {
+    $env:PATH = "$($arches[$a].bin);C:\Windows\System32;C:\Windows"
+    for ($r = 1; $r -le $Runs; $r++) {
+      $sw = [Diagnostics.Stopwatch]::StartNew()
+      $res = & $arches[$a].dash $script
+      $sw.Stop()
+      $rows += [pscustomobject]@{ bench = $b; arch = $a; run = $r; ms = [math]::Round($sw.Elapsed.TotalMilliseconds, 1); rc = $LASTEXITCODE; result = "$res" }
+    }
+  }
+}
+$rows | Export-Csv -NoTypeInformation -Path $Out
+foreach ($b in $benches) {
+  $line = "{0,-14}" -f $b
+  foreach ($a in $arches.Keys) {
+    $v = @($rows | Where-Object { $_.bench -eq $b -and $_.arch -eq $a } | Sort-Object ms | ForEach-Object { $_.ms })
+    $line += " {0}={1}ms" -f $a, $v[[int][math]::Floor($v.Count / 2)]
+  }
+  $line
+}
diff --git a/benchmarks/scripts/string_build.sh b/benchmarks/scripts/string_build.sh
new file mode 100644
index 0000000..a3912a9
--- /dev/null
+++ b/benchmarks/scripts/string_build.sh
@@ -0,0 +1,10 @@
+# string building and parameter-expansion trimming
+n=0; total=0
+while [ $n -lt 200 ]; do
+  s=""; i=0
+  while [ $i -lt 100 ]; do s="${s}x$i,"; i=$((i + 1)); done
+  t=$s; c=0
+  while [ -n "$t" ]; do t=${t#*,}; c=$((c + 1)); done
+  total=$((total + ${#s} + c)); n=$((n + 1))
+done
+echo "$total"
