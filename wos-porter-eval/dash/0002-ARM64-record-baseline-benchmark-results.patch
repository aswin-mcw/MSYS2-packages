--- /dev/null
+++ b/benchmarks/base_bench_win_arm.txt
@@ -0,0 +1,39 @@
+dash 0.5.13.5 (MSYS2 recipe) - Windows on ARM baseline benchmarks
+================================================================
+Host     : Snapdragon(R) X Elite - X1E80100 (Qualcomm Oryon), Windows 11 Enterprise build 26100, native ARM64
+Commit   : 047daafe6cfbc867609acddfecaba139e381458d (branch arm64-port)
+Date     : 2026-11-21T19:42Z
+ARM64    : build-arm64/src/dash.exe, aarch64-pc-cygwin-gcc 17.0.0 20260828, -O2 -static-libgcc,
+           runtime C:\gfw-native\native\usr\bin\msys-2.0.dll (3.6.10, AA64), native execution
+x64      : build-x64/src/dash.exe, x86_64-pc-msys gcc 16.2.0, -O2 -static-libgcc,
+           runtime C:\msys64\usr\bin\msys-2.0.dll (3.6.12, x64), emulated by Windows (Prism) on the same machine
+Method   : each dash launched directly from powershell.exe (root Cygwin process, PATH = its own usr\bin first),
+           wall time by System.Diagnostics.Stopwatch, 5 runs per arch, median reported.
+Reproduce: powershell -NoProfile -ExecutionPolicy Bypass -File benchmarks\scripts\run_bench.ps1 -Runs 5
+
+Benchmark       Workload                                   ARM64 native   x64 emulated   ARM64/x64
+--------------  -----------------------------------------  -------------  -------------  ---------
+arith_loop      1e6-iteration $(( )) while loop                3474.3 ms      3156.7 ms      1.10
+string_build    200 x (build 100-item string, trim by ${#})     195.7 ms       175.5 ms      1.12
+case_match      30000 x 10-word case/glob classification        536.3 ms       445.2 ms      1.20
+func_call       200000 shell function calls                     835.3 ms       838.9 ms      1.00
+fork_subshell   500 x $(:) command-substitution subshells      3068.5 ms      6243.6 ms      0.49
+
+(ARM64/x64 < 1.00 means native ARM64 is faster.)
+
+Raw runs (ms):
+arith_loop     arm64 3520.3 3469.2 3527.9 3474.3 3434.7 | x64 3156.7 3153.2 3217.4 3228.3 3132.8
+string_build   arm64  199.2  195.7  172.6  194.8  196.3 | x64  177.6  175.5  175.7  173.3  172.9
+case_match     arm64  560.9  533.1  536.3  550.6  532.4 | x64  478.2  442.0  469.2  443.5  445.2
+func_call      arm64  849.5  865.0  824.4  824.6  835.3 | x64  856.9  839.5  838.9  838.9  836.2
+fork_subshell  arm64 3116.8 2985.7 3095.5 3057.4 3068.5 | x64 6447.3 6303.7 6243.6 6074.3 6216.4
+
+All runs exited 0 and produced identical results on both arches
+(42 / 98000 / "90000 30000 30000 30000" / 840003 / 500).
+
+Notes:
+- Pure-interpreter loops are 0-20% slower native than emulated x64. Both are -O2, but the
+  aarch64 cross GCC is an experimental 17.0 snapshot configured --with-tune=cortex-a53, and the
+  two msys-2.0.dll runtimes differ (3.6.10 ARM64 vs 3.6.12 x64). Recorded as-is, not tuned.
+- fork_subshell (fork()+exec-free child per iteration, dominated by the Cygwin fork emulation in
+  msys-2.0.dll) is ~2x faster native.
diff --git a/benchmarks/scripts/arith_loop.sh b/benchmarks/scripts/arith_loop.sh
new file mode 100644
index 0000000..d1e718c
--- /dev/null
+++ b/benchmarks/scripts/arith_loop.sh
@@ -0,0 +1,4 @@
+# 1e6-iteration arithmetic while loop
+i=0; s=0
+while [ $i -lt 1000000 ]; do s=$(( (s + i * 7) % 1000003 )); i=$((i + 1)); done
+echo "$s"
diff --git a/benchmarks/scripts/case_match.sh b/benchmarks/scripts/case_match.sh
new file mode 100644
index 0000000..788776a
--- /dev/null
+++ b/benchmarks/scripts/case_match.sh
@@ -0,0 +1,11 @@
+# case/glob pattern matching loop
+i=0; a=0; b=0; c=0; d=0
+set -- apple banana cherry date elder fig grape 12345 x-y-z UPPER
+while [ $i -lt 30000 ]; do
+  for w; do
+    case $w in
+      [a-c]*) a=$((a + 1));; *[0-9]*) b=$((b + 1));; *-*-*) c=$((c + 1));; [[:upper:]]*) d=$((d + 1));; *) :;;
+    esac
+  done; i=$((i + 1))
+done
+echo "$a $b $c $d"
diff --git a/benchmarks/scripts/fork_subshell.sh b/benchmarks/scripts/fork_subshell.sh
